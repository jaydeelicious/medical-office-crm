@{
    ViewData["Title"] = "Sign out";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />
    <title>Medical Office CRM - Sign out</title>
</head>
<body>
    <main>
        <h1>Medical Office CRM</h1>

        <p>Are you sure you want to sign out?</p>

        <form method="post" action="/connect/logout">
            @Html.AntiForgeryToken()

            @foreach (var parameter in Context.Request.Query)
            {
                foreach (var value in parameter.Value)
                {
                    <input type="hidden"
                           name="@parameter.Key"
                           value="@value" />
                }
            }

            <button type="submit">Sign out</button>
        </form>

        <a href="http://localhost:4200/dashboard">
            Cancel
        </a>
    </main>
</body>
</html>
