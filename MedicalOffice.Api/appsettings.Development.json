{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MedicalOfficeDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "OpenIddict": {
    "Clients": {
      "Angular": {
        "RedirectUri": "http://localhost:4200/auth/callback",
        "PostLogoutRedirectUri": "http://localhost:4200/"
      }
    }
  }
}
